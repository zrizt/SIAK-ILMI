// ignore_for_file: type=lint
mixin _$TagihanDaoMixin on DatabaseAccessor<AppDatabase> {
  $SekolahTable get sekolah => attachedDatabase.sekolah;
  $KelasTable get kelas => attachedDatabase.kelas;
  $SiswaTable get siswa => attachedDatabase.siswa;
  $TagihanSiswaTable get tagihanSiswa => attachedDatabase.tagihanSiswa;
  $KategoriBiayaTable get kategoriBiaya => attachedDatabase.kategoriBiaya;
  $TagihanItemTable get tagihanItem => attachedDatabase.tagihanItem;
}
